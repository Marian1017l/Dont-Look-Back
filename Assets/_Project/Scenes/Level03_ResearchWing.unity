  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c4a3f4702be51a94ca7391e48dc34b82, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Document
  title: Informe del observador
  style: 2
  reference: OBS-07
  date: 06/12/1993
  author: Obs. P. Navarro
  text: "Desde la galer\xEDa se ve toda la c\xE1mara y el pasillo. En la sesi\xF3n
    6 cont\xE9 seis personas aqu\xED arriba. Al volver la luz, siete.\n\nLa s\xE9ptima
    estaba sentada a mi lado, en mi silla, y la silla no se hab\xEDa movido. Llevaba
    mi abrigo. Ten\xEDa mi cara, pero m\xE1s tranquila.\n\nBaj\xE9 sin avisar. No
    he vuelto a la galer\xEDa."
